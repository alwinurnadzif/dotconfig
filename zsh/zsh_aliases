# Text Editor
alias v="nvim"

# Git 
alias ga="git add"
alias gc="git commit"
alias gcmsg="git commit -m"
alias gb="git branch"
alias gco="git checkout"
alias gss="git status -s"
alias gp="git push"
alias glog="git log --oneline --decorate --graph"
alias gd="git diff"
alias gdclip="git diff | xclip -sel clipboard"
alias gdc="git diff | xclip -sel clipboard"


# xampp 
alias xampp="sudo /opt/lampp/lampp start"

# terminal 
alias c="clear"
alias ssr="shutdown -r now"
alias sss="shutdown now"

# Tmux 
alias t="tmux"


alias ws2hdmi='i3-msg "workspace 2; move workspace to output HDMI-A-0"'
alias ws3hdmi='i3-msg "workspace 3; move workspace to output HDMI-A-0"'

alias ws2edp='i3-msg "workspace 2; move workspace to output eDP"'
alias ws3edp='i3-msg "workspace 3; move workspace to output eDP"'

alias movehdmi='i3-msg "workspace 2; move workspace to output HDMI-A-0"; i3-msg "workspace 3; move workspace to output HDMI-A-0"'
alias moveedp='i3-msg "workspace 2; move workspace to output eDP"; i3-msg "workspace 3; move workspace to output eDP"'
