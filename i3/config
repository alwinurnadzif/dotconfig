set $mod Mod1

#font pango:monospace 14
font pango:Cousine Nerd Font 16

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id redshift 
exec --no-startup-id pasystray
exec --no-startup-id blueman-applet
exec --no-startup-id dunst
exec --no-startup-id feh --no-fehbg --bg-fill ~/Pictures/wallpaper/1.jpg --bg-fill ~/Pictures/wallpaper/1.jpg
exec --no-startup-id xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Natural Scrolling Enabled" 1
exec --no-startup-id xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Accel Speed" 0.8
exec --no-startup-id xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Tapping Enabled" 1

set $refresh_i3status killall -SIGUSR1 i3status

floating_modifier $mod

tiling_drag modifier titlebar
for_window [floating] resize set 70 ppt 70 ppt, move position center
for_window [class="pavucontrol"] floating enable, move position center
for_window [class="Pcmanfm"] floating enable, move position center
for_window [class="qterminal"] floating enable
for_window [class="Thunar"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable
# contoh untuk scratchpad terminal
for_window [con_mark="__i3_scratch"] move position center
for_window [class="^.*"] border pixel 2

include ./keybindings
include ./border
include ./bar

# exec --no-startup-id xinput set-button-map "SIGMACHIP Usb Mouse" 3 2 1

# Display
exec xrandr --output HDMI-A-0 --mode 1920x1080 --rate 99 --above eDP --auto

workspace 1 output eDP
workspace 2 output HDMI-A-0
workspace 3 output HDMI-A-0
workspace 4 output eDP

# workspace 2 output eDP
# workspace 3 output eDP

focus_follows_mouse no

gaps inner 8
gaps outer 8
smart_gaps off 
